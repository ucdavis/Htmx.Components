<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>

    <!-- NuGet Package Metadata -->
    <PackageId>Htmx.Components</PackageId>
    <Title>Htmx.Components</Title>
    <PackageDescription>A comprehensive ASP.NET Core library for building interactive web applications with server-side rendering and HTMX integration. Provides ready-to-use components, state management, and built-in authorization with minimal JavaScript.</PackageDescription>
    <PackageTags>htmx;aspnetcore;razor;components;server-side-rendering;interactive;web;mvc;tailwind;daisyui</PackageTags>
    <Authors>UC Davis</Authors>
    <Company>UC Davis</Company>
    <Copyright>Copyright (c) 2025 UC Davis</Copyright>
    
    <!-- Repository and Project URLs -->
    <RepositoryUrl>https://github.com/ucdavis/Htmx.Components</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/ucdavis/Htmx.Components</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageIcon>logo.png</PackageIcon>
    
    <!-- Release Notes -->
    <PackageReleaseNotes>See https://github.com/ucdavis/Htmx.Components/releases for release notes.</PackageReleaseNotes>
    
    <!-- Documentation -->
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <HtmxComponentsCssInput>tools/tailwind/extracted-css-classes.input.css</HtmxComponentsCssInput>
    <HtmxComponentsTailwindSource>tools/tailwind/extracted-css-classes.css</HtmxComponentsTailwindSource>
    <HtmxComponentsCssOutput>content/extracted-css-classes.generated.css</HtmxComponentsCssOutput>
    <HtmxComponentsNpmInstallStamp>node_modules/.install-stamp</HtmxComponentsNpmInstallStamp>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="content/extracted-css-classes.txt;content/css-extractor-patterns.txt;content/extracted-css-classes.generated.css;package.json;package-lock.json;tools/**" />
    <Content Remove="content/extracted-css-classes.txt;content/css-extractor-patterns.txt;content/extracted-css-classes.generated.css;package.json;package-lock.json;tools/**" />
    <Compile Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>

  <!-- Include package files -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
    <None Include="docs/images/logo.png" Pack="true" PackagePath="logo.png" />
    <None Update="content/extracted-css-classes.txt" Pack="false" />
    <None Include="$(HtmxComponentsTailwindSource)" Pack="true" PackagePath="content/extracted-css-classes.css" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FastExpressionCompiler" Version="5.0.3" />
    <PackageReference Include="Htmx" Version="1.8.1" />
    <PackageReference Include="Htmx.TagHelpers" Version="1.8.1" />
    <PackageReference Include="Humanizer" Version="2.14.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.3" />
    <PackageReference Include="Razor.Templating.Core" Version="2.1.0" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="System.Linq.Dynamic.Core" Version="1.6.6" />
  </ItemGroup>

  <ItemGroup>
    <RazorCompile Include="src/TagHelpers/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="src/**/*.cshtml" />
  </ItemGroup>

  <Target Name="HtmxComponentsNpmInstall"
          Inputs="package-lock.json"
          Outputs="$(HtmxComponentsNpmInstallStamp)"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="npm install" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Touch Files="$(HtmxComponentsNpmInstallStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="HtmxComponentsBuildCss"
          DependsOnTargets="HtmxComponentsNpmInstall"
          BeforeTargets="Build;Pack"
          Inputs="$(HtmxComponentsCssInput);$(HtmxComponentsTailwindSource);package.json;package-lock.json;@(EmbeddedResource);@(Compile)"
          Outputs="$(HtmxComponentsCssOutput)"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="npm run build:css" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>
