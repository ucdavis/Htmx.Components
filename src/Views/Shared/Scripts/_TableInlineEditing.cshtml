// Table inline editing for Htmx.Components
// Defines 'tableinline' extension and manages table editing mode visual states

htmx.defineExtension('tableinline', {
  // ensures afterbegin:#scoped-table-body inserts the entire <tr> element and not just the innerHTML
  isInlineSwap: function (swapStyle) { return true; },
});

document.addEventListener("htmx:afterSettle", () => {
  document.querySelectorAll("[data-hc-table-edit-toggle]").forEach((toggle) => {
    const component = toggle.closest("[data-hc-table-component]");

    if (!component) return;

    const editing = toggle.classList.contains("editing-mode");
    component.classList.toggle("editing-mode", editing);
  });
});
