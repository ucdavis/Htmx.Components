@using Htmx.Components.Table.Models
@using Htmx.Components.Table
@model ITableColumnModel

<div class="flex space-x-1">
       <input type="date" class="input input-bordered input-sm w-1/2" id="@TableComponentIdentity.FilterInputId(Model, "min")" name="filter"
              placeholder="From" hx-post="@Url.Action("SetFilter", "Form", new { typeId = Model.Table.TypeId })"
              hx-vals='@Html.Raw(TableComponentIdentity.HxVals(Model.Table.ComponentId, ("input", 1), ("column", Model.DataName)))' hx-swap="none"
              hx-trigger="input changed delay:500ms" />

       <input type="date" class="input input-bordered input-sm w-1/2" id="@TableComponentIdentity.FilterInputId(Model, "max")" name="filter"
              placeholder="To" hx-post="@Url.Action("SetFilter", "Form", new { typeId = Model.Table.TypeId })"
              hx-vals='@Html.Raw(TableComponentIdentity.HxVals(Model.Table.ComponentId, ("input", 2), ("column", Model.DataName)))' hx-swap="none"
              hx-trigger="input changed delay:500ms" />
</div>
