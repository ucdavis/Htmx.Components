@using Htmx.Components.Table.Models
@using Htmx.Components.Table
@model ITableModel
@{
        var requestScopeSelector = "#" + TableComponentIdentity.ContainerId(Model);
}
<div id="@TableComponentIdentity.PaginationId(Model)">
        <div class="flex justify-center items-center my-4 space-x-2">
                <div class="join">
                        <button type="button" class="btn btn-sm join-item"
                                hx-post="@Url.Action("SetPage", "Form", new { typeId = Model.TypeId })" hx-swap="none"
                                hx-vals='@Html.Raw(TableComponentIdentity.HxVals(Model.ComponentId, ("page", 1)))' disabled="@(Model.State.Page <= 1)"
                                hx-disabled-elt="this" data-hc-request-scope-selector="@requestScopeSelector">First</button>
                        <button type="button" class="btn btn-sm join-item"
                                hx-post="@Url.Action("SetPage", "Form", new { typeId = Model.TypeId })" hx-swap="none"
                                hx-vals='@Html.Raw(TableComponentIdentity.HxVals(Model.ComponentId, ("page", Model.State.Page - 1)))' disabled="@(Model.State.Page <= 1)"
                                hx-disabled-elt="this" data-hc-request-scope-selector="@requestScopeSelector">Prev</button>
                        <button type="button" class="btn btn-sm join-item btn-disabled cursor-default select-none"
                                tabindex="-1">page</button>
                        <input type="number" min="1" max="@Model.PageCount" id="@TableComponentIdentity.PageInputId(Model)" name="page"
                                class="input input-bordered input-sm join-item text-left" style="width:5rem;"
                                value="@Model.State.Page"
                                hx-post="@Url.Action("SetPage", "Form", new { typeId = Model.TypeId })" hx-swap="none"
                                hx-vals='@Html.Raw(TableComponentIdentity.HxVals(Model.ComponentId))'
                                hx-trigger="change, input changed delay:500ms" data-hc-request-scope-selector="@requestScopeSelector" />
                        <button type="button" class="btn btn-sm join-item btn-disabled cursor-default select-none"
                                tabindex="-1">of @Model.PageCount
                                <span style="display:inline-block; width:1rem;"></span>
                                <span class="text-sm">page size</span>
                        </button>
                        <select class="select select-bordered select-sm join-item" style="width:5rem;"
                                id="@TableComponentIdentity.PageSizeInputId(Model)" name="pageSize"
                                hx-post="@Url.Action("SetPageSize", "Form", new { typeId = Model.TypeId })"
                                hx-vals='@Html.Raw(TableComponentIdentity.HxVals(Model.ComponentId))' hx-swap="none" hx-trigger="change"
                                data-hc-request-scope-selector="@requestScopeSelector">
                                <option value="10" selected="@(Model.State.PageSize == 10)">10</option>
                                <option value="25" selected="@(Model.State.PageSize == 25)">25</option>
                                <option value="50" selected="@(Model.State.PageSize == 50)">50</option>
                                <option value="100" selected="@(Model.State.PageSize == 100)">100</option>
                        </select>
                        <button type="button" class="btn btn-sm join-item"
                                hx-post="@Url.Action("SetPage", "Form", new { typeId = Model.TypeId })" hx-swap="none"
                                hx-vals='@Html.Raw(TableComponentIdentity.HxVals(Model.ComponentId, ("page", Model.State.Page + 1)))'
                                disabled="@(Model.State.Page >= Model.PageCount)" hx-disabled-elt="this"
                                data-hc-request-scope-selector="@requestScopeSelector">Next</button>
                        <button type="button" class="btn btn-sm join-item"
                                hx-post="@Url.Action("SetPage", "Form", new { typeId = Model.TypeId })" hx-swap="none"
                                hx-vals='@Html.Raw(TableComponentIdentity.HxVals(Model.ComponentId, ("page", Model.PageCount)))' disabled="@(Model.State.Page >= Model.PageCount)"
                                hx-disabled-elt="this" data-hc-request-scope-selector="@requestScopeSelector">Last</button>
                        @* <button type="button" class="btn btn-sm join-item btn-disabled cursor-default select-none"
                                tabindex="-1">
                                <span style="display:inline-block; width:1rem;"></span>
                                <span class="text-sm">page size</span>
                        </button>
                        <select class="select select-bordered select-sm join-item" style="width:5rem;"
                                id="@TableComponentIdentity.PageSizeInputId(Model)-copy" name="pageSize"
                                hx-post="@Url.Action("SetPageSize", "Form", new { typeId = Model.TypeId })"
                                hx-vals='@Html.Raw(TableComponentIdentity.HxVals(Model.ComponentId))' hx-swap="none" hx-trigger="change">
                                <option value="10" selected="@(Model.State.PageSize == 10)">10</option>
                                <option value="25" selected="@(Model.State.PageSize == 25)">25</option>
                                <option value="50" selected="@(Model.State.PageSize == 50)">50</option>
                                <option value="100" selected="@(Model.State.PageSize == 100)">100</option>
                        </select> *@
                </div>
        </div>
</div>
