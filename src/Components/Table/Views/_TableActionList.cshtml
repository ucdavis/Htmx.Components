@using System.Text.Encodings.Web
@using Htmx.Components.Table.Models
@using Htmx.Components.Table
@model ITableModel

<div id="@TableComponentIdentity.ActionListId(Model)" class="flex justify-end mb-2 space-x-2">
    @foreach (var action in await Model.GetActionsAsync())
    {
        var attributes = TableComponentIdentity.WithScopedHxVals(action, Model.ComponentId);
        <button
            type="button"
            class="btn btn-sm @action.CssClass"
            @foreach (var attr in attributes)
            {
                var encodedValue = HtmlEncoder.Default.Encode(attr.Value);
                @Html.Raw($"{attr.Key}=\"{encodedValue}\"")
            }>
            @if (!string.IsNullOrWhiteSpace(action.Icon))
            {
                <i class="@action.Icon"></i>
            }
            @action.Label
        </button>
    }
</div>
