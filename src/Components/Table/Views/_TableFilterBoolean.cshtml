@using Htmx.Components.Table.Models
@using Htmx.Components.Table
@model ITableColumnModel

@{
    var currentFilter = Model.Table.State.Filters.TryGetValue(Model.DataName, out var filter)
        ? filter
        : "";
}

<select class="select select-bordered select-sm w-full" id="@TableComponentIdentity.FilterInputId(Model)" name="filter"
        hx-post="@Url.Action("SetFilter", "Form", new { typeId = Model.Table.TypeId })"
        hx-vals='@Html.Raw(TableComponentIdentity.HxVals(Model.Table.ComponentId, ("input", 0), ("column", Model.DataName)))' hx-swap="none" hx-trigger="change">
    <option value="" selected="@(currentFilter == "" ? "selected" : null)">All</option>
    <option value="true" selected="@(currentFilter == "true" ? "selected" : null)">True</option>
    <option value="false" selected="@(currentFilter == "false" ? "selected" : null)">False</option>
</select>
