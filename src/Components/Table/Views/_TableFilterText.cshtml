@using Htmx.Components.Table.Models
@using Htmx.Components.Table
@model ITableColumnModel

<input type="text" class="input input-bordered input-sm w-full" id="@TableComponentIdentity.FilterInputId(Model)" name="filter"
       hx-post="@Url.Action("SetFilter", "Form", new { typeId = Model.Table.TypeId })"
       hx-vals='@Html.Raw(TableComponentIdentity.HxVals(Model.Table.ComponentId, ("input", 0), ("column", Model.DataName)))' hx-swap="none" hx-trigger="input changed delay:500ms" />
