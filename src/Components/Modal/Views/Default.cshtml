@using Htmx.Components.Modal.Models
@model ModalModel

@{
    var modalBoxClass = string.IsNullOrWhiteSpace(Model.SizeClass)
        ? "modal-box"
        : $"modal-box {Model.SizeClass}";
}

<dialog id="@Model.Id"
        class="modal"
        aria-labelledby="@Model.TitleId"
        data-hc-modal
        data-hc-modal-body-target="#@Model.EffectiveBodyTargetId">
    <div class="@modalBoxClass" data-hc-modal-box>
        <div class="flex items-start justify-between gap-4" data-hc-modal-header>
            <h2 id="@Model.TitleId" class="text-lg font-semibold">@Model.Title</h2>
            <button type="button"
                    class="btn btn-sm btn-circle btn-ghost"
                    aria-label="@Model.CloseLabel"
                    data-hc-modal-close>
                x
            </button>
        </div>
        <div id="@Model.EffectiveBodyTargetId" data-hc-modal-body>
            @if (Model.Body is not null)
            {
                @Model.Body
            }
        </div>
    </div>
    <form method="dialog" class="modal-backdrop">
        <button type="submit" aria-label="@Model.CloseLabel" data-hc-modal-close>@Model.CloseLabel</button>
    </form>
</dialog>
